{
  "name": "ding",
  "version": "0.0.0",
  "private": true,
  "description": "Ding \u2014 Swiftee's WhatsApp-native omnichannel team inbox",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "check:threading": "tsx --tsconfig apps/api/tsconfig.json tools/check-threading.ts",
    "check:routing": "tsx --tsconfig apps/api/tsconfig.json tools/check-routing.ts",
    "check:outreach": "tsx --tsconfig apps/api/tsconfig.json tools/check-outreach.ts",
    "check:arrival-tags": "tsx --tsconfig apps/api/tsconfig.json tools/check-arrival-tags.ts",
    "check:channel-access": "tsx --tsconfig apps/api/tsconfig.json tools/check-channel-access.ts",
    "check:reply-to": "tsx --tsconfig apps/api/tsconfig.json tools/check-reply-to.ts",
    "check:email-forward": "tsx --tsconfig apps/api/tsconfig.json tools/check-email-forward.ts",
    "check:oba": "tsx --tsconfig apps/api/tsconfig.json tools/check-oba.ts",
    "check:coexistence": "tsx --tsconfig apps/api/tsconfig.json tools/check-coexistence.ts",
    "check:coexistence-pg": "tsx --tsconfig apps/api/tsconfig.json tools/check-coexistence-pg.ts",
    "check:whatsapp-register": "tsx tools/check-whatsapp-register.ts",
    "check:whatsapp-delivery": "tsx tools/check-whatsapp-delivery.ts",
    "check:template-scope": "tsx tools/check-template-scope.ts",
    "check:alert-policy": "tsx --tsconfig apps/api/tsconfig.json tools/check-alert-policy.ts",
    "check:team-alerts": "tsx --tsconfig apps/api/tsconfig.json tools/check-team-alerts.ts",
    "check:outbound-inbox": "tsx --tsconfig apps/api/tsconfig.json tools/check-outbound-inbox.ts",
    "check:note-replies": "tsx --tsconfig apps/api/tsconfig.json tools/check-note-replies.ts",
    "check:template-meta": "tsx --tsconfig apps/api/tsconfig.json tools/check-template-meta.ts",
    "check:default-template": "tsx --tsconfig apps/api/tsconfig.json tools/check-default-template.ts",
    "check:custom-fields": "tsx --tsconfig apps/api/tsconfig.json tools/check-custom-fields.ts",
    "check:conversation-subjects": "tsx --tsconfig apps/api/tsconfig.json tools/check-conversation-subjects.ts",
    "check:availability": "tsx --tsconfig apps/api/tsconfig.json tools/check-availability.ts",
    "check:email-cutover": "tsx --tsconfig apps/api/tsconfig.json tools/check-email-cutover.ts",
    "check:email-signature": "tsx --tsconfig apps/api/tsconfig.json tools/check-email-signature.ts",
    "check:email-signature-pg": "tsx --tsconfig apps/api/tsconfig.json tools/check-email-signature-pg.ts",
    "check:conversation-log": "tsx --tsconfig apps/api/tsconfig.json tools/check-conversation-log.ts",
    "check:org-routing": "tsx --tsconfig apps/api/tsconfig.json tools/check-org-routing.ts",
    "check:macros": "tsx --tsconfig apps/api/tsconfig.json tools/check-macros.ts",
    "check:macros-pg": "tsx --tsconfig apps/api/tsconfig.json tools/check-macros-pg.ts",
    "check:business-ops": "tsx --tsconfig apps/api/tsconfig.json tools/check-business-ops.ts",
    "check:accounts-sops": "tsx --tsconfig apps/api/tsconfig.json tools/check-accounts-sops.ts",
    "check:business-ops-pg": "tsx --tsconfig apps/api/tsconfig.json tools/check-business-ops-pg.ts",
    "check:gmail-reauth": "tsx --tsconfig apps/api/tsconfig.json tools/check-gmail-reauth.ts",
    "check:customer-bulk": "tsx --tsconfig apps/api/tsconfig.json tools/check-customer-bulk.ts",
    "check:nestchat-away": "tsx --tsconfig apps/api/tsconfig.json tools/check-nestchat-away.ts",
    "check:phone-audio": "tsx --tsconfig apps/api/tsconfig.json tools/check-phone-audio.ts",
    "check:transcribe": "tsx --tsconfig apps/api/tsconfig.json tools/check-transcribe.ts",
    "check:team-chat": "tsx --tsconfig apps/api/tsconfig.json tools/check-team-chat.ts",
    "check:team-chat-pg": "tsx --tsconfig apps/api/tsconfig.json tools/check-team-chat-pg.ts",
    "check:organisations": "tsx --tsconfig apps/api/tsconfig.json tools/check-organisations.ts",
    "check:organisations-pg": "tsx --tsconfig apps/api/tsconfig.json tools/check-organisations-pg.ts",
    "check:app-surface": "tsx --tsconfig apps/api/tsconfig.json tools/check-app-surface.ts",
    "check:app-identity": "tsx --tsconfig apps/api/tsconfig.json tools/check-app-identity.ts",
    "check:app-threads": "tsx --tsconfig apps/api/tsconfig.json tools/check-app-threads.ts",
    "check:website-identity": "tsx --tsconfig apps/api/tsconfig.json tools/check-website-identity.ts",
    "check:conversation-counts": "tsx --tsconfig apps/api/tsconfig.json tools/check-conversation-counts.ts",
    "check:tenant-isolation": "tsx --tsconfig apps/api/tsconfig.json tools/check-release-tenant.ts && tsx --tsconfig apps/api/tsconfig.json tools/check-tenant-isolation.ts",
    "check:tenant-http": "tsx --tsconfig apps/api/tsconfig.json tools/check-tenant-http.ts",
    "check:workspaces-http": "tsx --tsconfig apps/api/tsconfig.json tools/check-workspaces-http.ts",
    "check:workspace-lifecycle-http": "tsx --tsconfig apps/api/tsconfig.json tools/check-workspace-lifecycle-http.ts",
    "check:sms": "tsx --tsconfig apps/api/tsconfig.json tools/check-sms.ts",
    "check:reviewer-workspace": "tsx --tsconfig apps/api/tsconfig.json tools/check-release-sandbox.ts && tsx --tsconfig apps/api/tsconfig.json tools/check-sandbox-storage.ts && tsx --tsconfig apps/api/tsconfig.json tools/check-reviewer-workspace.ts",
    "check:visitor-uploads": "tsx --tsconfig apps/api/tsconfig.json tools/check-visitor-uploads.ts",
    "check:customer-push": "tsx --tsconfig apps/api/tsconfig.json tools/check-customer-push.ts",
    "check:app-badge": "tsx --tsconfig apps/api/tsconfig.json tools/check-app-badge.ts",
    "check:reactions": "tsx --tsconfig apps/api/tsconfig.json tools/check-reactions.ts",
    "check:field-filter": "tsx --tsconfig apps/api/tsconfig.json tools/check-field-filter.ts",
    "check:visitor-events": "tsx --tsconfig apps/api/tsconfig.json tools/check-visitor-events.ts",
    "check:visitor-history": "tsx --tsconfig apps/api/tsconfig.json tools/check-visitor-history.ts",
    "check:2fa-gate": "tsx --tsconfig apps/api/tsconfig.json tools/check-2fa-gate.ts",
    "check:trusted-device": "tsx --tsconfig apps/api/tsconfig.json tools/check-trusted-device.ts",
    "check:privacy-route": "tsx --tsconfig apps/api/tsconfig.json tools/check-privacy-route.ts",
    "check:hooks": "node tools/check-hook-order.mjs",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @ding/api db:generate",
    "db:migrate": "pnpm --filter @ding/api db:migrate",
    "db:seed": "pnpm --filter @ding/api db:seed",
    "eas-build-post-install": "pnpm --filter \"@ding/client...\" build",
    "check:channel-order": "tsx tools/check-channel-order.ts",
    "check:sdk-version": "tsx tools/check-sdk-version.ts"
  },
  "devDependencies": {
    "pixelmatch": "^5.3.0",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

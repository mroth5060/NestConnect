// Ding data model — the Postgres/Prisma schema behind the platform.
// Phase 0 runs on in-memory fixtures; this is the real persistence layer,
// ready for `prisma migrate`. Mirrors docs/04-data-model.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChannelType {
  whatsapp
  whatsapp_group
  email
  nestchat
  sms
}

enum ConversationStatus {
  open
  pending
  snoozed
  closed
}

enum MessageDirection {
  in
  out
}

enum MessageStatus {
  queued
  sending
  sent
  delivered
  read
  failed
}

enum AuthorType {
  contact
  user
  system
}

enum Priority {
  low
  normal
  high
  urgent
}

enum Role {
  admin
  manager
  agent
}

enum RoutingStrategy {
  manual
  round_robin
  load_balanced
  most_idle
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  region    String   @default("uk")
  // A demo workspace (e.g. for app-store reviewers): synthetic data only, and
  // nothing it does reaches anyone — sends are simulated, channels can't be
  // connected, no email/push/AI leaves it. See tenancy/sandbox.ts.
  sandbox   Boolean  @default(false)
  createdAt DateTime @default(now())
  // active | suspended | archived | deleting. Anything but active is frozen:
  // nobody signs in, its channels take nothing in and send nothing out, and its
  // jobs skip it (tenancy/workspace-status.ts). Set by the platform's owners.
  status    String   @default("active")
  statusAt  DateTime?
  // A workspace being deleted is wiped for good at this time; until then it
  // can be restored.
  purgeAt   DateTime?

  users         User[]
  teams         Team[]
  inboxes       Inbox[]
  contacts      Contact[]
  conversations Conversation[]
  labels        Label[]
  templates     Template[]
  auditLogs     AuditLog[]
  customFields  CustomField[]
  accounts      Account[]
  macros        Macro[]
  opsCollections OpsCollection[]
  opsSops        OpsSop[]
  chatRooms      ChatRoom[]
}

/// A fact a workspace wants to record that we did not think of.
///
/// Defined once and used anywhere, rather than a column per idea: "order id" is
/// a food-delivery business's word for the thing a booking agency calls a
/// booking reference and an insurer calls a policy number. Adding a column for
/// each would mean shipping a migration every time somebody integrates
/// something, and a schema that reads as a list of our customers.
///
/// Org-level rather than channel-level, with an optional restriction to
/// particular channels: an order id belongs on the app's chats *and* on the
/// WhatsApp number the same customers message, and defining it twice would make
/// them two unrelated things to search.
model CustomField {
  id       String @id @default(cuid())
  orgId    String
  /// Stable machine name — what an SDK sends. Never changes once in use.
  key      String
  /// What an agent reads. Free to change; the key is the identity.
  label    String
  /// text | number | date | url | select
  type     String @default("text")
  /// contact | conversation. A contact's facts follow the person; a
  /// conversation's belong to one thread — which is which is the difference
  /// between "this customer's loyalty tier" and "the order this chat is about".
  entity   String
  /// The choices, for `select`. Empty for every other type.
  options  String[] @default([])
  /// Which channels offer it. Empty means all of them.
  inboxIds String[] @default([])
  /// Display order in the panel, low first.
  position Int     @default(0)
  /// Whether this field gets a chip in the inbox's filter row.
  ///
  /// Opt-in, and off by default, because the two are different questions. A
  /// field is defined because it is worth recording; a chip is worth its place
  /// only if people filter by it — and a row that grows a chip every time
  /// somebody adds a field is a row nobody reads.
  filterable Boolean @default(false)
  /// Retired rather than deleted: the values already recorded against it are
  /// history, and deleting the definition would silently destroy them.
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  org    Organization       @relation(fields: [orgId], references: [id])
  values CustomFieldValue[]

  @@unique([orgId, key])
  @@index([orgId, entity, archived])
}

/// One field's value on one contact or one conversation.
///
/// A table rather than a JSON column on each row, and the reason is search. An
/// order number is looked up far more often than it is written — an agent has a
/// customer on the phone reading it out — and that has to be an index hit, not
/// a scan of every conversation's JSON.
model CustomFieldValue {
  id       String @id @default(cuid())
  /// Denormalised from the field, so a search can be scoped without a join.
  orgId    String
  fieldId  String
  entity   String
  entityId String
  /// As entered, for display.
  value    String
  /// Folded for matching: trimmed, lower-cased, and for the shapes people write
  /// reference numbers in, stripped of spaces and dashes. "dg 88412" finds
  /// "DG-88412", because the customer reading it out loud does not know which
  /// way it was typed.
  normalizedValue String

  field CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  /// One value per field per record.
  @@unique([fieldId, entity, entityId])
  /// The panel's read: every field on the record being opened.
  @@index([orgId, entity, entityId])
  /// The search: every record carrying this value.
  @@index([orgId, fieldId, normalizedValue])
  /// The same, when the field isn't known — a bare id typed into the search box.
  @@index([orgId, normalizedValue])
}

model User {
  id          String   @id @default(cuid())
  orgId       String
  name         String
  email        String
  role         Role     @default(agent)
  avatarColor  String?
  // Uploaded profile photo, served via /api/media/:id. Falls back to Gravatar,
  // then coloured initials, when null.
  avatarUrl    String?
  online       Boolean  @default(false)
  // Manual "accepting work" flag (distinct from `online` presence) — an
  // unavailable agent is skipped by round-robin auto-assignment.
  available    Boolean  @default(true)
  // Working hours (availabilityScheduleSchema). Null: the switch alone decides.
  availabilitySchedule Json?
  // Retired: the personal signature, replaced by each email channel's own
  // design (Inbox.signatureHtml). Kept so nothing anyone wrote is lost; no
  // longer sent or shown.
  emailSignature String?
  // Job title ("Operations Manager"), filled into email signatures.
  position     String?
  passwordHash String?
  // Emailed-invite flow: SHA-256 of a single-use token + its expiry. Cleared
  // once the invitee sets their password.
  inviteTokenHash String?
  inviteExpiresAt DateTime?
  // Two-factor auth. `twoFactorEnabled` gates login; `twoFactorMethod` is
  // "totp" (authenticator app) or "email". `totpSecret` is the base32 secret,
  // encrypted at rest — present-but-not-enabled means enrolment is in progress.
  twoFactorEnabled Boolean @default(false)
  twoFactorMethod  String?
  totpSecret       String?
  // Emailed one-time code for the "email" method / enrolment: hash + expiry.
  twoFactorEmailCodeHash    String?
  twoFactorEmailCodeExpires DateTime?
  // Which push notifications this person wants, as JSON (see PushPreferences).
  // Null = the defaults: assigned-to-me, mentions, assignments and reminders on,
  // all-team-inbound off — the setting that otherwise makes people uninstall.
  pushPrefs                 String?
  /// Who this person signs in as (see Login). A User is one person's place in
  /// one workspace — role, teams, preferences — and the same person can have
  /// one in several workspaces, all pointing at one Login. The password and
  /// second-factor columns above are retired copies from before Login
  /// existed: nothing reads or writes them any more.
  loginId      String?
  createdAt    DateTime @default(now())

  org         Organization   @relation(fields: [orgId], references: [id])
  login       Login?         @relation(fields: [loginId], references: [id], onDelete: SetNull)
  memberships TeamMember[]
  assigned    Conversation[] @relation("assignee")
  messages    Message[]
  notes       Note[]
  notifications Notification[]
  opsAcks       OpsAck[]
  opsChecklists OpsChecklist[]
  routedAccounts Account[]    @relation("AccountRouteUser")
  sessions    Session[]
  devices     Device[]
  recoveryCodes RecoveryCode[]
  chatMemberships ChatMember[]
  chatMessages    ChatMessage[] @relation("ChatAuthor")
  chatAudits      ChatAudit[]
  chatPresence    ChatPresence?
  chatStars       ChatStar[]
  noteFollowUps   NoteFollowUp[]

  @@unique([orgId, email])
  /// One place per person per workspace.
  @@unique([orgId, loginId])
  @@index([orgId])
  @@index([loginId])
}

/// Who someone is when they sign in: one per email address, across every
/// workspace they belong to. It holds what proves it's them — the password and
/// the second factor — so changing either changes it everywhere at once. Each
/// workspace they're in is a User row pointing here.
///
/// Belongs to no workspace, so the tenant-scoped client can't reach it: only
/// the store's unscoped client reads or writes it, and only for signing in.
model Login {
  id                        String    @id @default(cuid())
  /// Lower-cased; what they type to sign in.
  email                     String    @unique
  passwordHash              String?
  twoFactorEnabled          Boolean   @default(false)
  twoFactorMethod           String?
  totpSecret                String?
  twoFactorEmailCodeHash    String?
  twoFactorEmailCodeExpires DateTime?
  /// "Forgot password": SHA-256 of a single-use token and its expiry.
  resetTokenHash            String?
  resetExpiresAt            DateTime?
  /// The workspace they were last in — where signing in takes them.
  lastOrgId                 String?
  createdAt                 DateTime  @default(now())

  users         User[]
  recoveryCodes RecoveryCode[]
}

// One-time backup codes for 2FA recovery (lost authenticator). Stored hashed;
// `usedAt` marks a spent code so it can't be replayed.
model RecoveryCode {
  id        String    @id @default(cuid())
  /// Retired: the codes belong to the Login now. Kept on rows made before.
  userId    String?
  loginId   String?
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  login Login? @relation(fields: [loginId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loginId])
}

// A signed-in device/browser. The session id rides in the JWT as its `jti`, so a
// revoked row (revokedAt set) invalidates that cookie on the next request —
// which is what powers "where you're signed in" + remote sign-out.
model Session {
  id         String    @id @default(cuid())
  userId     String
  // Captured at sign-in for the "where you're logged in" list.
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  // Set when the session is signed out (here or remotely); nulls = active.
  revokedAt  DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  devices Device[]

  @@index([userId])
}

// A phone (or tablet) that can receive push. Keyed by the push token, because
// that IS the address we send to — a reinstall produces a new token and so a new
// row, and the same token can never belong to two people at once.
//
// `sessionId` ties the device to the sign-in that registered it, so remote
// sign-out stops its notifications instead of leaving a signed-out phone still
// buzzing. `disabledAt` + `disabledReason` record a token the push service told
// us is dead (`DeviceNotRegistered`) or one whose owner revoked permission in OS
// settings — without it we'd push at a dead address forever.
model Device {
  id             String    @id @default(cuid())
  userId         String
  sessionId      String?
  // The Expo push token ("ExponentPushToken[...]"). Unique: one row per address.
  pushToken      String    @unique
  platform       String
  // App + OS build, for triaging "only broken on iOS 26" reports.
  appVersion     String?
  osVersion      String?
  deviceName     String?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  disabledAt     DateTime?
  disabledReason String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

/// A per-user bell notification (a mention, a snooze coming due, …).
model Notification {
  id             String   @id @default(cuid())
  userId         String
  type           String
  title          String
  body           String   @default("")
  conversationId String?
  /// A Business Ops SOP to open instead (review reminders, must-reads).
  opsSopId       String?
  /// A Team Chat chat to open instead (an @mention there).
  chatRoomId     String?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  opsSop         OpsSop?  @relation(fields: [opsSopId], references: [id], onDelete: Cascade)
  chatRoom       ChatRoom? @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Team {
  id              String          @id @default(cuid())
  orgId           String
  name            String
  icon            String?
  order           Int             @default(0)
  slaMinutes      Int?
  routingStrategy RoutingStrategy @default(manual)

  org           Organization   @relation(fields: [orgId], references: [id])
  members       TeamMember[]
  inboxes       InboxTeam[]
  conversations Conversation[] @relation("assignedTeam")
  macros        MacroTeam[]
  opsSops       OpsSopTeam[]
  chatRoom      ChatRoom?
  routedAccounts Account[]   @relation("AccountRouteTeam")

  @@index([orgId])
}

model TeamMember {
  userId String
  teamId String
  role   String @default("member")

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@id([userId, teamId])
}

model Inbox {
  id              String          @id @default(cuid())
  orgId           String
  type            ChannelType
  name            String
  handle          String
  routingStrategy RoutingStrategy @default(manual)
  channelConfig   Json?
  // The number/address this channel sends from when a reply is switched onto it
  // from a thread that started somewhere else. Without one the oldest inbox of
  // the type wins, which is deterministic but arbitrary — this is how a
  // workspace with two numbers says which one it wants to be known by.
  //
  // At most one per (org, channel type), enforced by a partial unique index in
  // the migration rather than by the setter alone: it decides which number a
  // customer sees, and two rows claiming it would be a coin toss again.
  isDefault       Boolean         @default(false)
  /// Where this channel sits in the sidebar, low first — the same idea as
  /// Team.order and set the same way, by the arrows in Settings.
  ///
  /// Every existing row starts at 0, which is a deliberate tie rather than a
  /// default nobody chose: the ordering falls back to createdAt, so a
  /// workspace that has never touched the arrows keeps exactly the order it
  /// had, and one that has keeps its own.
  order           Int             @default(0)
  /// An email channel's signature: the layout, with tags like
  /// {{agent.position}} filled per sender, and the marketing section under it.
  /// Null layout = never designed, so the default one is used.
  signatureHtml       String?
  signatureFooterHtml String?
  /// Put on every customer who starts a conversation here (a contact tag),
  /// and on every conversation that starts here (a label) — where they came
  /// from, without anyone having to file it.
  contactTag          String?
  conversationLabelId String?
  createdAt       DateTime        @default(now())

  org           Organization     @relation(fields: [orgId], references: [id])
  teams         InboxTeam[]
  conversations Conversation[]
  devices       CustomerDevice[]

  @@index([orgId])
}

model InboxTeam {
  inboxId String
  teamId  String

  inbox Inbox @relation(fields: [inboxId], references: [id])
  team  Team  @relation(fields: [teamId], references: [id])

  @@id([inboxId, teamId])
}

model Contact {
  id          String   @id @default(cuid())
  orgId       String
  displayName String
  company     String?
  avatarColor String?
  tags        String[] @default([])
  ownerUserId String?
  ownerTeamId String?
  // Blocked: inbound messages from this contact are dropped and they're hidden
  // from the customer directory by default.
  blocked     Boolean  @default(false)
  createdAt   DateTime @default(now())

  org           Organization      @relation(fields: [orgId], references: [id])
  identities    ContactIdentity[]
  conversations Conversation[]
  participations Participant[]
  devices        CustomerDevice[]
  accountLinks   AccountContact[]

  @@index([orgId])
}

model ContactIdentity {
  id        String  @id @default(cuid())
  contactId String
  orgId     String? // denormalized from the contact, for per-org identity lookups
  kind      String // phone | email | wa_id
  value     String // as entered / received (kept for display)
  normalizedValue String? // canonical form for dedup: E.164 phone, lowercase email
  verified  Boolean @default(false)

  contact Contact @relation(fields: [contactId], references: [id])

  // Per workspace: the same customer can message two businesses on the platform,
  // and each has its own contact for them.
  @@unique([orgId, kind, value])
  @@index([contactId])
  @@index([orgId, kind, normalizedValue])
}

/// A customer's phone, for push.
///
/// Separate from `Device` on purpose. That one belongs to a *User* — an agent
/// with a login, a session and a role — and is addressed through Expo because
/// the agent app is an Expo app. This belongs to a Contact: somebody who has
/// never signed in to anything of ours, reachable through whatever push service
/// the business's own app already uses. Sharing a table would mean a nullable
/// userId and a nullable contactId with a comment explaining that exactly one
/// is set, which is two tables wearing one name.
model CustomerDevice {
  id        String @id @default(cuid())
  orgId     String
  contactId String
  /// Which channel registered it. A customer with two of the business's apps
  /// has two devices here, and a reply on one must not ring the other.
  inboxId   String
  /// The FCM registration token. Unique: one row per address, so a phone that
  /// re-registers moves rather than accumulating.
  token     String @unique
  /// ios | android | web
  platform  String

  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  /// Set when the push service says the address is dead. Kept rather than
  /// deleted so a token that comes back can be told apart from a new one.
  disabledAt     DateTime?
  disabledReason String?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  inbox   Inbox   @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@index([contactId, inboxId])
  @@index([orgId])
}

model Conversation {
  id             String             @id @default(cuid())
  orgId          String
  inboxId        String
  contactId      String
  channel        ChannelType
  subject        String?
  /// Whether Nest writes this thread's subject (new WhatsApp and website-chat
  /// threads): custom field values, then a short topic. Off for email, whose
  /// subject is the customer's own, and for every thread from before it existed.
  subjectAuto    Boolean            @default(false)
  /// The topic half of an automatic subject — AI-written from the customer's
  /// first messages, or what they picked from the chat's menu. Kept apart so a
  /// field set later can be put in front without asking the AI again.
  subjectTopic   String?
  /// Website chat: the highest message seq already emailed to a visitor who
  /// had left before reading it. Claimed atomically, so a reply is emailed once.
  visitorEmailedSeq Int              @default(0)
  /// The organisation this conversation is about, when someone chose one —
  /// a contact who works for several companies can't decide it on their own.
  accountId      String?
  inviteLink     String?
  channelRef     String?
  status         ConversationStatus @default(open)
  assigneeUserId String?
  assignedTeamId String?
  priority       Priority           @default(normal)
  unread         Boolean            @default(false)
  unreadCount    Int                @default(0)
  slaDueAt       DateTime?
  snoozedUntil   DateTime?
  lastActivityAt DateTime           @default(now())
  // Timestamp of the most recent inbound (customer) message — drives WhatsApp's
  // 24-hour customer-service window. Null until the customer first messages.
  lastInboundAt  DateTime?
  seq            Int                @default(0)
  preview        String             @default("")
  createdAt      DateTime           @default(now())

  org              Organization        @relation(fields: [orgId], references: [id])
  inbox            Inbox               @relation(fields: [inboxId], references: [id])
  contact          Contact             @relation(fields: [contactId], references: [id])
  assignee         User?               @relation("assignee", fields: [assigneeUserId], references: [id])
  team             Team?               @relation("assignedTeam", fields: [assignedTeamId], references: [id])
  messages         Message[]
  notes            Note[]
  labels           ConversationLabel[]
  participants     Participant[]
  assignmentEvents AssignmentEvent[]
  events           ConversationEvent[]
  chatShares       ChatMessage[]
  noteFollowUps    NoteFollowUp[]
  account          Account?            @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([orgId, inboxId, status, lastActivityAt])
  @@index([orgId, assigneeUserId, status, lastActivityAt])
  @@index([channelRef])
  @@index([accountId])
}

/// Someone else's conversation in my My Inbound, because of its internal notes:
/// a note @mentioned me, or someone wrote in notes I'm part of (I wrote one, or
/// was mentioned in one). It goes when I write a note or reply here, when I
/// dismiss it, or when the conversation is closed. One row per person.
model NoteFollowUp {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  /// "mention" (a note @mentioned them) or "reply" (someone wrote in notes
  /// they're part of) — for the tag that says why it's there.
  reason         String
  /// Who wrote the note that brought it in.
  byUserId       String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Participant {
  id             String   @id @default(cuid())
  conversationId String
  contactId      String
  role           String   @default("member")
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  contact      Contact      @relation(fields: [contactId], references: [id])

  @@unique([conversationId, contactId])
  @@index([conversationId])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  seq            Int
  direction      MessageDirection
  authorType     AuthorType
  authorUserId   String?
  authorName     String?
  body           String
  // The channel this specific message was sent/received on. Lets one open
  // conversation carry messages across channels (WhatsApp, email …). Null on
  // legacy rows → falls back to the conversation's channel.
  channel        ChannelType?
  // Which inbox this actually went out from — the WhatsApp number or mailbox the
  // customer saw it arrive from. Resolved at delivery, not at compose: a reply
  // sent on a channel the conversation didn't start on goes from that channel's
  // inbox, which needn't be the conversation's. Null on legacy rows and on
  // inbound → falls back to the conversation's inbox, which is right for every
  // message that never went cross-channel.
  inboxId        String?
  // Sanitized HTML body for rich email (rendered in a sandboxed iframe); the
  // plain `body` above stays the fallback + preview text.
  bodyHtml       String?
  status         MessageStatus    @default(sent)
  internal       Boolean          @default(false)
  channelMsgId   String?
  // text | image | video | audio | voice | document | sticker | location | contact
  messageType    String           @default("text")
  // Emoji reactions: [{ emoji, by: "contact" | "user" }] (≤1 per participant).
  reactions      Json?
  // Id of the message this one quotes/replies to (same conversation).
  quotedMsgId    String?
  // Passed on from elsewhere rather than written here: set when an agent forwards
  // a message, and when WhatsApp flags an inbound one as forwarded to us.
  forwarded      Boolean          @default(false)
  // Sent by Nest itself, not a person: "away" (the website chat's reply while
  // nobody is online) or "away_ask" (that reply, asking for an email).
  auto           String?
  // ---- durable outbound delivery bookkeeping (out messages only) ----
  // How many provider send attempts have been made, and when the last one ran.
  attemptCount   Int              @default(0)
  lastAttemptAt  DateTime?
  // Last provider/transport error message + code (diagnostics; backend-only).
  providerError  String?
  providerErrorCode String?
  // Human-readable reason once the send has permanently failed (shown in the UI).
  failureReason  String?
  // Dedup key for the delivery job (also the BullMQ jobId) — prevents double sends.
  idempotencyKey String?
  // Channel-specific send hints needed to (re)deliver from the DB alone after a
  // restart: { template?: { name, language, params }, cc?, bcc? }.
  deliveryMeta   Json?
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  author       User?        @relation(fields: [authorUserId], references: [id])
  attachments  Attachment[]
  // Per-recipient email open-tracking rows (one per To/Cc address on an
  // outbound email; each carries a unique tracking-pixel token).
  emailRecipients EmailRecipient[]

  @@index([conversationId, seq])
  // Backs inbound idempotency + delivery-status lookups (both hit channelMsgId).
  @@index([channelMsgId])
  // Dedup outbound sends by idempotency key.
  @@unique([idempotencyKey])
  // Restart recovery scans for still-in-flight outbound messages.
  @@index([direction, status])
}

model Attachment {
  id         String   @id @default(cuid())
  // The workspace it belongs to. Carried on the row itself, not only through
  // its message, because an upload staged in the composer has no message yet.
  orgId      String?
  // Null while an upload is staged (not yet attached to a sent message).
  messageId  String?
  // Storage object key (R2/S3 key or local path).
  r2Key      String
  mime       String
  size       Int
  filename   String
  // image | video | audio | voice | document | sticker | file
  kind       String   @default("file")
  // Audio/video length in ms; image intrinsic size; voice waveform peaks (JSON).
  durationMs Int?
  width      Int?
  height     Int?
  waveform   String?
  // A voice note or audio file in words, once someone asked for it (Transcribe).
  // Kept so the next person to ask, or the same one on another device, gets it
  // straight away and it's only paid for once.
  transcript String?
  createdAt  DateTime @default(now())

  message Message? @relation(fields: [messageId], references: [id])

  @@index([messageId])
  @@index([orgId])
}

/// One outbound-email recipient (To or Cc), tracked individually for read
/// receipts. Each recipient gets their own copy of the email carrying a unique
/// tracking-pixel token; a request for that pixel stamps `openedAt`. This is the
/// per-recipient model Front uses: you see who opened, not just that someone did.
model EmailRecipient {
  id        String    @id @default(cuid())
  messageId String
  // The recipient's email address (lower-cased).
  address   String
  // "to" | "cc" — where this address sat on the outbound email.
  kind      String    @default("to")
  // Unguessable token embedded in this recipient's tracking-pixel URL.
  token     String    @unique
  // When the tracking pixel was first requested (null until opened).
  openedAt  DateTime?
  // How many times the pixel has been requested (opens + re-opens/prefetches).
  openCount Int       @default(0)
  createdAt DateTime  @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Note {
  id             String   @id @default(cuid())
  conversationId String
  authorUserId   String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  author       User         @relation(fields: [authorUserId], references: [id])
}

model Label {
  id    String @id @default(cuid())
  orgId String
  name  String
  color String

  org           Organization        @relation(fields: [orgId], references: [id])
  conversations ConversationLabel[]

  @@unique([orgId, name])
}

model ConversationLabel {
  conversationId String
  labelId        String

  conversation Conversation @relation(fields: [conversationId], references: [id])
  label        Label        @relation(fields: [labelId], references: [id])

  @@id([conversationId, labelId])
}

model AssignmentEvent {
  id             String   @id @default(cuid())
  conversationId String
  fromUserId     String?
  toUserId       String?
  toTeamId       String?
  byUserId       String?
  reason         String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
}

model Template {
  id             String @id @default(cuid())
  orgId          String
  name           String
  category       String // marketing | utility | authentication
  language       String @default("en")
  body           String
  approvalStatus String @default("pending")

  /// What each {{1}}, {{2}} … starts out as when somebody sends this.
  ///
  /// Index-aligned with the body's variables, and free text with {{token}}
  /// placeholders in it (see TEMPLATE_TOKENS) so "Hi from {{agent.name}}",
  /// plain "Order update" and a bare "{{contact.name}}" are all one kind of
  /// thing. Pre-filled, never forced: the fill form still opens and an agent
  /// can change any of it before sending.
  variableDefaults String[] @default([])

  /// The WhatsApp Business Account this template lives on.
  ///
  /// Templates belong to a WABA, not to a phone number: every number under one
  /// WABA can send all of its templates, and no number can send another WABA's.
  /// Without this column a workspace with two accounts shows one merged list,
  /// and roughly half of it fails at Meta with "template name does not exist"
  /// depending on which number the agent happened to be sending from.
  ///
  /// Null means "not claimed by any account yet" — a locally authored template,
  /// or one written before this column existed. Those show for every account
  /// until a sync tells us whose they are, because hiding a template everywhere
  /// is worse than showing it in one place too many.
  wabaId         String?

  org Organization @relation(fields: [orgId], references: [id])

  /// Two accounts may each have their own "order_update" in English, and they
  /// are different templates. Postgres treats NULLs as distinct here, so
  /// unclaimed rows never block a synced one from being inserted.
  ///
  /// That same NULL handling would also let two *unclaimed* rows share a name,
  /// which the old workspace-wide key prevented. A partial unique index in the
  /// migration keeps that guarantee for rows belonging to no account; Prisma
  /// has no syntax for a partial index, so it lives in SQL only and this
  /// comment is the pointer to it.
  @@unique([orgId, wabaId, name, language])
}

model RoutingRule {
  id         String          @id @default(cuid())
  inboxId    String?
  teamId     String?
  strategy   RoutingStrategy @default(manual)
  conditions Json?
  priority   Int             @default(0)
}

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String
  actor     String
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
}

// Org-scoped app-level settings (e.g. the Google OAuth app client id/secret set
// in Settings › Setup). A plain key/value store keyed by (orgId, key).
model AppSetting {
  orgId String
  key   String
  value String

  @@id([orgId, key])
}

// Diagnostics for inbound webhooks that could not be handled deterministically —
// e.g. an event for a phone number/address we don't manage, or a bad signature.
// Deliberately org-less: these are recorded before (or because) tenant
// resolution failed, so they must not be pinned to an arbitrary org.
model WebhookDiagnostic {
  id        String   @id @default(cuid())
  // The workspace it concerns, when one could be identified. Null for an event
  // no inbox matched — those are visible to the platform's operators only.
  orgId     String?
  channel   String // whatsapp | whatsapp_group | email | gmail
  kind      String // unmapped_inbox | bad_signature | unmapped_group
  reference String? // phone number id / email address / group id
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([orgId, createdAt])
}

/// ─── Organisations ───────────────────────────────────────────────────────
/// A customer company and what it takes to serve it. Shown as "Organisation";
/// called Account here because Organization is the workspace. Every account
/// belongs to one workspace — one business's customer knowledge is never
/// another's. Archived, never deleted: contacts and conversations outlive it.
enum AccountStatus {
  active
  prospect
  inactive
}

model Account {
  id            String        @id @default(cuid())
  orgId         String
  name          String
  /// Lower-cased, punctuation and legal suffix stripped — spots a duplicate.
  nameKey       String
  legalName     String?
  reference     String?
  summary       String        @default("")
  overview      String        @default("")
  status        AccountStatus @default(active)
  tags          String[]      @default([])
  ownerUserId   String?
  /// Where this organisation's people's new chats go, unless a contact has
  /// routing of their own. See docs/organisations.md › Routing.
  routeTeamId   String?
  routeUserId   String?
  phone         String?
  email         String?
  website       String?
  address       String?
  archivedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdById   String?
  createdByName String?
  updatedById   String?
  updatedByName String?

  org           Organization      @relation(fields: [orgId], references: [id])
  routeTeam     Team?             @relation("AccountRouteTeam", fields: [routeTeamId], references: [id], onDelete: SetNull)
  routeUser     User?             @relation("AccountRouteUser", fields: [routeUserId], references: [id], onDelete: SetNull)
  contacts      AccountContact[]
  alerts        AccountAlert[]
  sops          AccountSop[]
  notes         AccountNote[]
  resources     AccountResource[]
  activity      AccountActivity[]
  conversations Conversation[]

  @@index([orgId, archivedAt, name])
  @@index([orgId, nameKey])
}

/// A contact's place in an organisation. Many-to-many: a person can work for
/// several companies. Removing the link never touches the contact.
model AccountContact {
  id         String   @id @default(cuid())
  accountId  String
  contactId  String
  role       String?
  department String?
  isPrimary  Boolean  @default(false)
  notes      String?
  createdAt  DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([accountId, contactId])
  @@index([contactId])
}

/// Something everyone must see before acting for this customer.
model AccountAlert {
  id            String   @id @default(cuid())
  accountId     String
  body          String
  /// critical | important | info
  priority      String   @default("important")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?
  createdByName String?
  updatedById   String?
  updatedByName String?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

/// A standard operating procedure. Every saved change keeps the version it
/// replaced (AccountSopRevision), so an instruction can always be traced.
model AccountSop {
  id            String   @id @default(cuid())
  accountId     String
  title         String
  category      String   @default("General")
  summary       String   @default("")
  warnings      String   @default("")
  /// [{ text }] — the procedure in order.
  steps         Json     @default("[]")
  /// Sanitized HTML.
  body          String   @default("")
  /// active | draft | archived
  status        String   @default("active")
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?
  createdByName String?
  updatedById   String?
  updatedByName String?

  account   Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  revisions AccountSopRevision[]
  resources AccountResource[]

  @@index([accountId, status])
}

model AccountSopRevision {
  id           String   @id @default(cuid())
  sopId        String
  version      Int
  title        String
  category     String
  summary      String
  warnings     String
  steps        Json
  body         String
  status       String
  editedAt     DateTime
  editedById   String?
  editedByName String?
  createdAt    DateTime @default(now())

  sop AccountSop @relation(fields: [sopId], references: [id], onDelete: Cascade)

  @@index([sopId, version])
}

/// Lasting customer knowledge that isn't a procedure. Not a conversation note.
model AccountNote {
  id            String   @id @default(cuid())
  accountId     String
  title         String   @default("")
  /// Sanitized HTML.
  body          String
  category      String   @default("General")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?
  createdByName String?
  updatedById   String?
  updatedByName String?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

/// A document, link or external app the team needs for this customer.
model AccountResource {
  id            String   @id @default(cuid())
  accountId     String
  /// link | file | app
  kind          String
  title         String
  description   String   @default("")
  category      String   @default("General")
  url           String?
  instructions  String   @default("")
  /// A stored upload (Attachment with no message), served by /api/media/:id.
  attachmentId  String?
  sopId         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?
  createdByName String?

  account Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sop     AccountSop? @relation(fields: [sopId], references: [id], onDelete: SetNull)

  @@index([accountId])
}

/// What changed on an organisation, by whom and when.
model AccountActivity {
  id        String   @id @default(cuid())
  accountId String
  actorId   String?
  actorName String?
  action    String
  summary   String
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
}

/// A saved reply an agent drops into the composer and edits before sending.
/// Belongs to team inboxes through MacroTeam; none means every team.
/// See docs/macros.md.
model Macro {
  id            String   @id @default(cuid())
  orgId         String
  name          String
  /// Typed after "/" in the composer. Unique within a workspace when set.
  shortcut      String?
  body          String
  createdById   String?
  createdByName String?
  updatedById   String?
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org   Organization @relation(fields: [orgId], references: [id])
  teams MacroTeam[]

  @@unique([orgId, shortcut])
  @@index([orgId])
}

model MacroTeam {
  macroId String
  teamId  String

  macro Macro @relation(fields: [macroId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([macroId, teamId])
  @@index([teamId])
}

/// Business Ops: the workspace's own standard operating procedures, read by the
/// teams they're assigned to, written by admins and managers. See
/// docs/business-ops.md.
model OpsCollection {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  /// An emoji.
  icon      String   @default("📁")
  color     String   @default("#0FA47A")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id])
  sops OpsSop[]

  @@unique([orgId, name])
  @@index([orgId])
}

model OpsSop {
  id                String    @id @default(cuid())
  orgId             String
  collectionId      String?
  title             String
  icon              String    @default("📘")
  color             String    @default("#0FA47A")
  summary           String    @default("")
  /// "Before you start": what to watch out for.
  warnings          String    @default("")
  /// [{ text, imageUrl?, link? }] — the procedure in order.
  steps             Json      @default("[]")
  /// Sanitized HTML.
  body              String    @default("")
  /// [{ id, kind: link|file, title, url }]
  resources         Json      @default("[]")
  /// Every team reads it, now and later.
  allTeams          Boolean   @default(false)
  /// draft | published | archived
  status            String    @default("draft")
  /// The published version; 0 until it is first published.
  version           Int       @default(0)
  /// Readers confirm each new version.
  mustRead          Boolean   @default(false)
  reviewEveryMonths Int?
  reviewDueAt       DateTime?
  /// When the owner was told this review is due (once per due date).
  reviewNotifiedAt  DateTime?
  lastReviewedAt    DateTime?
  ownerUserId       String?
  ownerName         String?
  publishedAt       DateTime?
  createdById       String?
  createdByName     String?
  updatedById       String?
  updatedByName     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  org           Organization     @relation(fields: [orgId], references: [id])
  collection    OpsCollection?   @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  teams         OpsSopTeam[]
  revisions     OpsSopRevision[]
  acks          OpsAck[]
  checklists    OpsChecklist[]
  notifications Notification[]

  @@index([orgId, status])
  @@index([reviewDueAt])
}

model OpsSopTeam {
  opsSopId String
  teamId   String

  opsSop OpsSop @relation(fields: [opsSopId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([opsSopId, teamId])
  @@index([teamId])
}

/// Each publish, as it read then.
model OpsSopRevision {
  id              String   @id @default(cuid())
  opsSopId        String
  version         Int
  title           String
  summary         String
  warnings        String
  steps           Json
  body            String
  note            String   @default("")
  publishedAt     DateTime @default(now())
  publishedById   String?
  publishedByName String?

  opsSop OpsSop @relation(fields: [opsSopId], references: [id], onDelete: Cascade)

  @@unique([opsSopId, version])
}

/// "I've read this": the latest version each person confirmed.
model OpsAck {
  opsSopId String
  userId   String
  version  Int
  at       DateTime @default(now())

  opsSop OpsSop @relation(fields: [opsSopId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([opsSopId, userId])
  @@index([userId])
}

/// One person's ticks on an SOP's steps.
model OpsChecklist {
  opsSopId  String
  userId    String
  /// Step indexes ticked.
  done      Json     @default("[]")
  updatedAt DateTime @updatedAt

  opsSop OpsSop @relation(fields: [opsSopId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([opsSopId, userId])
}

/// The conversation's log: routing, assignment, status and every change made
/// to it, besides its messages. See docs/conversation-log.md.
model ConversationEvent {
  id             String   @id @default(cuid())
  conversationId String
  /// created | routed | assigned | unassigned | team_changed | closed | reopened
  /// | snoozed | woke | priority | labels | subject | organisation | fields
  /// | message_failed | message_retried | shared_to_chat
  type           String
  /// agent | customer | system
  actorKind      String
  /// The teammate, when it was one. Names are resolved when the log is read.
  actorUserId    String?
  /// What changed — ids, old and new values, a reason — as the type needs.
  data           Json     @default("{}")
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─── Team Chat ─────────────────────────────────────────────────────────────
// Direct messages, groups, and one chat per team. See docs/team-chat.md.

model ChatRoom {
  id            String   @id @default(cuid())
  orgId         String
  /// direct | group | team
  kind          String
  /// A group's name. Empty for a direct message; a team chat shows its team's.
  name          String   @default("")
  emoji         String?
  /// The team a team chat belongs to. Its members are the team's.
  teamId        String?  @unique
  /// "userA:userB", sorted — one direct chat per pair.
  directKey     String?
  createdById   String?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  org           Organization   @relation(fields: [orgId], references: [id])
  team          Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  members       ChatMember[]
  messages      ChatMessage[]
  audits        ChatAudit[]
  notifications Notification[]

  @@unique([orgId, directKey])
  @@index([orgId, lastMessageAt])
}

/// A person in a chat, and their own state in it. For a team chat the team
/// decides who is in it; these rows only hold each person's markers.
model ChatMember {
  roomId          String
  userId          String
  /// admin | member
  role            String    @default("member")
  joinedAt        DateTime  @default(now())
  /// Read everything up to here.
  lastReadAt      DateTime?
  /// Their app has received everything up to here.
  lastDeliveredAt DateTime?
  mutedUntil      DateTime?
  pinnedAt        DateTime?

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
}

model ChatMessage {
  id           String    @id @default(cuid())
  roomId       String
  authorUserId String?
  /// text | system
  kind         String    @default("text")
  body         String    @default("")
  /// A system message's event (ChatSystemData).
  data         Json?
  replyToId    String?
  /// { "👍": [userId, …] }
  reactions    Json      @default("{}")
  /// User ids it @-mentions.
  mentions     Json      @default("[]")
  /// Photos, voice notes, files (the inbox's Attachment shape).
  attachments  Json      @default("[]")
  /// A preview of the first link in it, once fetched.
  link         Json?
  /// A customer conversation shared into the chat to discuss, and its card as
  /// it was when shared (ChatSharedConversation, less the live status).
  conversationId String?
  shared         Json?
  editedAt     DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  room    ChatRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author  User?         @relation("ChatAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  replyTo ChatMessage?  @relation("ChatReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies ChatMessage[] @relation("ChatReply")
  stars   ChatStar[]
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
  @@index([conversationId])
  @@index([replyToId])
}

/// An admin opened a chat they aren't in.
model ChatAudit {
  id     String   @id @default(cuid())
  roomId String
  userId String
  at     DateTime @default(now())

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, at])
}

/// When someone was last connected, for "last seen".
model ChatPresence {
  userId     String   @id
  lastSeenAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A message someone starred, to find again.
model ChatStar {
  userId        String
  chatMessageId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatMessage ChatMessage @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)

  @@id([userId, chatMessageId])
  @@index([userId, createdAt])
}

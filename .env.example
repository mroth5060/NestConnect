# ---- API ----
API_PORT=3001
# Allowed browser origin for CORS + Socket.IO (the web app in dev)
CORS_ORIGIN=http://localhost:5173

# ---- Auth ----
# Secret used to sign session JWTs (change in every real environment).
AUTH_JWT_SECRET=ding-dev-secret-change-me
AUTH_COOKIE_NAME=ding_session
AUTH_TTL_SECONDS=604800
# Password given to all seeded demo users (dev only).
AUTH_DEV_PASSWORD=ding1234
# Two-factor enrolment is mandatory: signing in without it lands on the setup
# gate. Set to false to skip that gate while developing — ignored in production,
# where 2FA is always required.
AUTH_REQUIRE_2FA=true

# ---- Secret encryption (integration credentials at rest) ----
# Master key for AES-256-GCM encryption of stored OAuth tokens + app secrets
# (Meta/Google/Postmark/R2). Loaded from the env only, NEVER stored in Postgres.
# Prefer a base64- or hex-encoded 32-byte random key, e.g.:
#   openssl rand -base64 32
# Unset ⇒ encryption disabled (secrets stored as plaintext — dev only).
# After setting it on an existing DB, run:
#   pnpm --filter @ding/api db:encrypt-secrets
SECRET_ENCRYPTION_KEY=

# ---- Database (Postgres) ----
# The API runs on in-memory fixtures when DATABASE_URL is unset, so you can
# `pnpm dev` with zero infra. Set this (and run `pnpm db:up`) for the real path.
DATABASE_URL=postgresql://ding:ding@localhost:5432/ding?schema=public

# ---- Redis ----
# Optional. When set, the realtime gateway uses the Redis adapter so it can
# scale across multiple nodes. Unset = single-node in-memory (fine for dev).
REDIS_URL=redis://localhost:6379

# ---- Messaging mock (dev/demo only) ----
# By default an outbound send on a channel with no live credentials FAILS and the
# error is shown to the agent — production never fakes delivery. Set this to true
# in local dev to instead simulate a successful send (and a delivered/read ladder)
# so the flow is exercisable without connecting a real number/mailbox. Ignored in
# production (NODE_ENV=production), where it is always off.
MOCK_MESSAGING=false

# ---- WhatsApp (Cloud API) ----
WHATSAPP_VERIFY_TOKEN=ding-dev-verify
# App secret → validates the X-Hub-Signature-256 on inbound webhooks (optional in dev).
WHATSAPP_APP_SECRET=
# Set these two to send for real via the Cloud API. Without them a WhatsApp send
# FAILS with a "not connected" error the agent sees (unless MOCK_MESSAGING=true).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# ---- Email (Cloud) ----
# Set POSTMARK_TOKEN to send for real. Without it an email send FAILS with a
# "not connected" error the agent sees (unless MOCK_MESSAGING=true).
POSTMARK_TOKEN=
EMAIL_FROM=support@hermolis.com
EMAIL_DOMAIN=hermolis.com
# Optional shared secret; when set, inbound email webhooks must pass ?token=.
EMAIL_INBOUND_TOKEN=

# ---- Google / Gmail (OAuth "Connect with Google") ----
# The app-level Google OAuth client id + secret are set in-product under
# Settings › Setup (stored per-org in AppSettings), NOT here. When this flag is
# true the whole consent flow is MOCKED — the popup completes end-to-end with
# fake tokens and a demo Gmail address, so it works with no real Google creds.
GOOGLE_OAUTH_MOCK=false
# Inbound Gmail polling cadence in seconds (0 disables polling → push-only).
GMAIL_POLL_SECONDS=60
# Optional shared secret; when set, the Pub/Sub push webhook must pass ?token=.
GMAIL_PUSH_TOKEN=

# ---- Media storage ----
# Local-disk fallback dir (ephemeral on Railway). Used when R2 is not configured.
MEDIA_DIR=
# Max single media file to download/store, in bytes (default 100MB).
MEDIA_MAX_BYTES=
# Cloudflare R2 (S3-compatible). Set ALL FOUR to store media in R2 for
# production durability; otherwise media goes to local disk. The endpoint is
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com — create an R2 bucket + an
# API token (Object Read & Write) in the Cloudflare dashboard.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---- Meta / WhatsApp (OAuth "Connect with Facebook") ----
# The app-level Meta app id + secret (+ optional Embedded Signup config id) are
# set in-product under Settings › Setup (stored per-org in AppSettings), NOT here.
# When true the whole WhatsApp connect flow is MOCKED — the popup completes with
# a demo number, so it works with no real Meta credentials.
META_OAUTH_MOCK=false

# ---- Web (Vite) ----
# In dev the web app proxies /api and /socket.io to the API, so this is only
# needed if you point the web build at a non-proxied API.
VITE_API_URL=
